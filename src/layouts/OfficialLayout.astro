---
import "../styles/main.css";
import Icon from "../components/community/Icon.astro";
import { SITE_NAME } from "../data/config";

/**
 * 官网首页布局（官方壳）：顶部导航 + 主内容 + Footer，无侧边栏。
 * 复刻主应用 OfficialLayout（SiteNavbar + main + Footer）的视觉。
 */
interface Props {
  title: string;
  description?: string;
  /** 当前路径，用于顶栏激活态 */
  currentPath?: string;
}

const { title, description = "理科迷 (LKM) 独立官网", currentPath = "/" } =
  Astro.props;

// 顶栏导航（静态站现有页面）
const navLinks = [
  { href: "/", label: "首页" },
  { href: "/about", label: "关于" },
  { href: "/services", label: "服务" },
  { href: "/team", label: "团队" },
  { href: "/community", label: "社区" },
];

// Footer 硬编码栏目（链接指向静态站现有页）
const footerCols = [
  {
    title: "社区",
    links: [
      { text: "七月团队", href: "/team" },
      { text: "管理团队", href: "/team" },
      { text: "发展历程", href: "/" },
      { text: "QQ社群", href: "/communities" },
    ],
  },
  {
    title: "页面",
    links: [
      { text: "服务", href: "/services" },
      { text: "支持我们", href: "/pricing" },
      { text: "联系我们", href: "/contact" },
      { text: "常见问题", href: "/community" },
    ],
  },
  {
    title: "法律",
    links: [
      { text: "隐私政策", href: "/about" },
      { text: "使用条款", href: "/about" },
    ],
  },
];
---

<!doctype html>
<html lang="zh-cn" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="bg-white text-base-content antialiased tracking-tight">
    {/* 顶部导航（复刻官方壳：sticky 72px 白底） */}
    <div class="sticky top-0 z-50">
      <div class="bg-white dark:bg-[oklch(0.23_0.015_var(--hue))] overflow-hidden shadow-sm dark:shadow-none h-[4.5rem] grid grid-cols-[0.6fr_auto_1fr] items-center px-4 sm:px-6">
        <div class="flex items-center gap-1 justify-self-start">
          <a href="/" class="rounded-lg h-[3.25rem] px-2 sm:px-5 font-bold flex items-center text-neutral-800 hover:bg-black/5 transition-colors">
            <span class="flex flex-row items-center text-[var(--primary)] text-md">
              <Icon name="home" class="w-7 h-7 mb-1 mr-2" />
              {SITE_NAME}
            </span>
          </a>
        </div>

        <nav class="hidden md:flex" aria-label="主导航">
          {
            navLinks.map((l) => (
              <a
                href={l.href}
                class:list={[
                  "rounded-lg h-11 font-bold px-4 active:scale-95 flex items-center gap-1 transition-colors",
                  currentPath === l.href
                    ? "text-[var(--primary)] hover:bg-black/5"
                    : "text-neutral-700 hover:text-[var(--primary)] hover:bg-black/5",
                ]}
              >
                {l.label}
              </a>
            ))
          }
        </nav>

        <div class="md:hidden justify-self-end flex items-center">
          <a href="/community" class="rounded-lg h-11 px-4 font-bold flex items-center text-sm text-[var(--primary)] hover:bg-black/5 transition-colors">
            社区
          </a>
        </div>
      </div>
    </div>

    <main>
      <slot />
    </main>

    {/* 页脚（复刻主应用 Footer） */}
    <footer class="relative border-t border-surface-3 not-prose">
      <div class="absolute inset-0 pointer-events-none bg-white dark:bg-[oklch(0.23_0.015_var(--hue))]" aria-hidden="true"></div>
      <div class="relative max-w-7xl mx-auto px-4 md:px-6 text-text-muted">
        <div class="grid grid-cols-12 gap-4 gap-y-8 sm:gap-8 py-[64px]">
          <div class="col-span-12 lg:col-span-4">
            <div class="mb-2">
              <a href="/" class="inline-block text-[17px] font-semibold text-deep-text no-underline">
                {SITE_NAME}
              </a>
            </div>
            <div class="text-[12px] text-text-muted">
              理科迷 LKM © 2026 · 保留所有权利。
            </div>
          </div>
          {
            footerCols.map((col) => (
              <div class="col-span-12 sm:col-span-6 md:col-span-3 lg:col-span-2">
                <div class="text-[14px] font-semibold text-deep-text mb-2">{col.title}</div>
                <ul class="text-[12px] leading-[2.41]">
                  {col.links.map((l) => (
                    <li class="mb-2">
                      <a class="text-[12px] text-text-muted hover:text-deep-text hover:underline transition duration-150 ease-in-out" href={l.href}>
                        {l.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <div class="md:flex md:items-center md:justify-between py-6 md:py-8 border-t border-surface-3">
          <ul class="flex mb-4 md:order-1 -ml-2 md:ml-4 md:mb-0">
            <li>
              <a class="text-text-muted hover:text-deep-text focus:outline-none focus:ring-2 rounded-[8px] text-sm p-2.5 inline-flex items-center" aria-label="GitHub" href="https://github.com/LKM-AHZ" target="_blank" rel="noopener">
                <Icon name="github" class="w-5 h-5" />
              </a>
            </li>
            <li>
              <a class="text-text-muted hover:text-deep-text focus:outline-none focus:ring-2 rounded-[8px] text-sm p-2.5 inline-flex items-center" aria-label="RSS" href="/">
                <Icon name="rss" class="w-5 h-5" />
              </a>
            </li>
          </ul>
          <div class="text-[12px] mr-4 text-text-muted">理科迷 LKM © 2026 · 保留所有权利。</div>
        </div>
      </div>
    </footer>
  </body>
</html>
