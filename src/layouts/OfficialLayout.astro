---
import "../styles/main.css";
import Icon from "../components/Icon.astro";
import { SITE_NAME } from "../data/config"; // 品牌名不翻译，保持中文
import { t } from "../i18n/index";
import type { TranslationKey } from "../i18n/index";
import { langUrl } from "../i18n/paths";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";

/**
 * 官网首页布局（官方壳）：顶部导航 + 主内容 + Footer，无侧边栏。
 * 复刻主应用 OfficialLayout（SiteNavbar + main + Footer）的视觉。
 */
interface Props {
  title: string;
  description?: string;
  /** 当前路径，用于顶栏激活态 */
  currentPath?: string;
}

const lang = (Astro.currentLocale ?? "zh") as string;
const { title, description = t(lang, "common.site.description"), currentPath = "/" } =
  Astro.props;

// 顶栏导航（静态站现有页面）
const navLinks: { href: string; key: TranslationKey }[] = [
  { href: "/", key: "common.nav_home" },
  { href: "/news", key: "common.nav_articles" },
  { href: "/about", key: "common.nav_about" },
  { href: "/team", key: "common.nav_team" },
];

// Footer 硬编码栏目（链接指向静态站现有页）
const footerCols: {
  titleKey: TranslationKey;
  links: { textKey: TranslationKey; href: string }[];
}[] = [
  {
    titleKey: "common.footer.col_community",
    links: [
      { textKey: "common.footer.team", href: "/team" },
      { textKey: "common.footer.management", href: "/team" },
      { textKey: "common.footer.timeline", href: "/" },
      { textKey: "common.footer.qq_groups", href: "/communities" },
    ],
  },
  {
    titleKey: "common.footer.col_pages",
    links: [
      { textKey: "common.nav_services", href: "/services" },
      { textKey: "common.footer.support_us", href: "/pricing" },
      { textKey: "common.footer.contact", href: "/contact" },
      { textKey: "common.footer.faq", href: "/" },
    ],
  },
  {
    titleKey: "common.footer.col_legal",
    links: [
      { textKey: "common.footer.privacy", href: "/about" },
      { textKey: "common.footer.terms", href: "/about" },
    ],
  },
];
---

<!doctype html>
<html lang={lang === "en" ? "en" : "zh-CN"} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="bg-white text-base-content antialiased tracking-tight">
    <div class="sticky top-0 z-50">
      <div class="bg-white dark:bg-[oklch(0.23_0.015_var(--hue))] overflow-hidden shadow-sm dark:shadow-none relative h-[4.5rem] flex items-center justify-between px-4 sm:px-6">
        <div class="flex items-center gap-1">
          <a href={langUrl(lang, "/")} class="rounded-lg h-[3.25rem] px-2 sm:px-5 font-bold flex items-center text-neutral-800 hover:bg-black/5 transition-colors">
            <span class="flex flex-row items-center text-[var(--primary)] text-md">
              <Icon name="home" class="w-7 h-7 mb-1 mr-2" />
              {SITE_NAME}
            </span>
          </a>
        </div>

        <nav class="hidden md:flex absolute left-[48%] top-1/2 -translate-x-1/2 -translate-y-1/2 items-center" aria-label={t(lang, "common.aria.main_nav")}>
          {
            navLinks.map((l) => (
              <a
                href={langUrl(lang, l.href)}
                class:list={[
                  "rounded-lg h-11 font-bold px-10 active:scale-95 flex items-center gap-1 transition-colors",
                  currentPath === l.href
                    ? "text-[var(--primary)] hover:bg-black/5"
                    : "text-neutral-700 hover:text-[var(--primary)] hover:bg-black/5",
                ]}
              >
                {t(lang, l.key)}
              </a>
            ))
          }
        </nav>

        <div class="flex items-center gap-2">
          <a href={langUrl(lang, "/communities")} class="md:hidden rounded-lg h-11 px-4 font-bold flex items-center text-sm text-[var(--primary)] hover:bg-black/5 transition-colors">
            {t(lang, "common.nav_communities")}
          </a>
          <LanguageSwitcher />
        </div>
      </div>
    </div>

    <main>
      <slot />
    </main>

    {/* 页脚（复刻主应用 Footer） */}
    <footer class="relative border-t border-surface-3 not-prose">
      <div class="absolute inset-0 pointer-events-none bg-white dark:bg-[oklch(0.23_0.015_var(--hue))]" aria-hidden="true"></div>
      <div class="relative max-w-7xl mx-auto px-4 md:px-6 text-text-muted">
        <div class="grid grid-cols-12 gap-4 gap-y-8 sm:gap-8 py-[64px]">
          <div class="col-span-12 lg:col-span-4">
            <div class="mb-2">
              <a href={langUrl(lang, "/")} class="inline-block text-[17px] font-semibold text-deep-text no-underline">
                {SITE_NAME}
              </a>
            </div>
            <div class="text-[12px] text-text-muted">
              {t(lang, "common.footer.copyright")}
            </div>
          </div>
          {
            footerCols.map((col) => (
              <div class="col-span-12 sm:col-span-6 md:col-span-3 lg:col-span-2">
                <div class="text-[14px] font-semibold text-deep-text mb-2">{t(lang, col.titleKey)}</div>
                <ul class="text-[12px] leading-[2.41]">
                  {col.links.map((l) => (
                    <li class="mb-2">
                      <a class="text-[12px] text-text-muted hover:text-deep-text hover:underline transition duration-150 ease-in-out" href={langUrl(lang, l.href)}>
                        {t(lang, l.textKey)}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <div class="md:flex md:items-center md:justify-between py-6 md:py-8 border-t border-surface-3">
          <ul class="flex mb-4 md:order-1 -ml-2 md:ml-4 md:mb-0">
            <li>
              <a class="text-text-muted hover:text-deep-text focus:outline-none focus:ring-2 rounded-[8px] text-sm p-2.5 inline-flex items-center" aria-label={t(lang, "common.aria.github")} href="https://github.com/LKM-AHZ" target="_blank" rel="noopener">
                <Icon name="github" class="w-5 h-5" />
              </a>
            </li>
            <li>
              <a class="text-text-muted hover:text-deep-text focus:outline-none focus:ring-2 rounded-[8px] text-sm p-2.5 inline-flex items-center" aria-label={t(lang, "common.aria.rss")} href={langUrl(lang, "/")}>
                <Icon name="rss" class="w-5 h-5" />
              </a>
            </li>
          </ul>
          <div class="text-[12px] mr-4 text-text-muted">{t(lang, "common.footer.copyright")}</div>
        </div>
      </div>
    </footer>
  </body>
</html>
