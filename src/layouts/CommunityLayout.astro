---
import "../styles/main.css";
import CommunityTopNav from "../components/community/CommunityTopNav.astro";
import CommunitySidebar from "../components/community/CommunitySidebar.astro";
import styles from "../components/community/CommunitySidebar.module.css";

/**
 * 社区外壳布局：顶部导航 + 左侧可折叠侧边栏 + 主内容区。
 * 复刻主应用 CommunityLayout / CommunitySidebarLayout 的视觉与尺寸。
 */
interface SidebarItem {
  text: string;
  href: string;
  icon: string;
}

interface Props {
  title: string;
  description?: string;
  /** 当前社区子页路径，用于侧边栏激活态 */
  currentPath?: string;
  /** 侧边栏条目（默认社区导航） */
  sidebarItems?: SidebarItem[];
}

const {
  title,
  description = "理科迷 (LKM) 独立官网",
  currentPath = "/community",
  sidebarItems = [
    { text: "首页", href: "/community", icon: "home" },
    { text: "论坛", href: "/community/forum", icon: "forum" },
    { text: "专栏", href: "/community/columns", icon: "article" },
    { text: "文件库", href: "/community/files", icon: "folder" },
    { text: "竞赛", href: "/community/competition", icon: "trophy" },
  ],
} = Astro.props;
---

<!doctype html>
<html lang="zh-cn" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="bg-white text-[#1d1d1f]">
    <CommunityTopNav active={currentPath} />
    <div class="min-h-screen">
      <CommunitySidebar items={sidebarItems} currentPath={currentPath} />

      {/* 主内容区：随侧边栏展开/收起偏移 */}
      <main class={styles.mainShell}>
        <div class="max-w-7xl mx-auto px-4 md:px-6 py-16 md:py-20 lg:py-24">
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>
