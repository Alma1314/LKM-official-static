---
import OfficialSidebarLayout from "../../layouts/OfficialSidebarLayout.astro";
import Icon from "../../components/Icon.astro";
import { t } from "../../i18n/index";
import { langUrl } from "../../i18n/paths";

const lang = (Astro.currentLocale ?? "zh") as string;

import { getStaticPathsForLang } from "../../i18n/paths";
export const getStaticPaths = getStaticPathsForLang;

// ===== 服务页（复刻主应用 /official/services，结构文案 t()，卡片数据阶段二）=====

const sidebarItems = [
  { text: t(lang, "services.sidebar_content"), href: "#content", icon: "pencil" },
  { text: t(lang, "services.sidebar_events"), href: "#events", icon: "confetti" },
  { text: t(lang, "services.sidebar_platform"), href: "#platform", icon: "database" },
];

// 内容创作 9 卡
const contentItems = [
  { icon: "news", title: "科技新闻", desc: "追踪全球科技前沿动态，用通俗易懂的语言解读最新科学发现与技术突破，让你第一时间掌握科技脉搏。" },
  { icon: "atom", title: "学科科普", desc: "覆盖数学、物理、化学、生物、信息技术等核心学科，从基础概念到前沿理论，循序渐进带你进入科学的世界。" },
  { icon: "video", title: "视频创作", desc: "通过B站等视频平台发布教学、科普视频，以及硬核优质内容，以生动直观的方式展现科学与技术知识点，让抽象的公理和理论变得眼见为实。" },
  { icon: "helpCircle", title: "相关帮助", desc: "我们会提供不限于学习、竞赛、专业、考试、技能和方向等等具有实质性并且最新的建议，打破参考和意见，打破信息差。" },
  { icon: "fileText", title: "专题深度", desc: "针对热门科学话题推出系列专题文章，深入浅出地剖析背后的科学原理，培养批判性思维和科学素养。" },
  { icon: "trophy", title: "知识竞赛", desc: "定期举办线上学科知识竞赛，寓教于乐，激发学习兴趣，在轻松的氛围中检验和巩固所学知识。" },
  { icon: "books", title: "资源分享", desc: "整理和分享优质学习资料、书籍推荐、在线课程等学习资源，帮助社区成员找到最适合自己的学习路径。" },
  { icon: "book", title: "科技期刊", desc: "在未来我们会组建期刊项目组，给大家呈现一年或半年内，社区共建共享所产出的实质性内容和成果，如优秀的文章、科普、创作作品等等。" },
  { icon: "language", title: "中外交流", desc: "在未来我们会组建翻译组，传播和搬运中外优质的科技论文、文章、讲解和讲课视频，做到双向的输入输出。" },
];

// 社区活动 4 卡
const eventItems = [
  { icon: "sun", title: "假期活动", desc: "一年一度的寒暑假主题活动，由七月团队·活动策划部统筹组织。汇集线上讲座、学科研讨、趣味竞赛等多种形式，是社区每年最大的盛事。" },
  { icon: "presentation", title: "学科研讨会", desc: "由专业委员会委员和各学科爱好者共同参与，定期举办专题研讨，针对特定科学话题展开深入讨论与交流。" },
  { icon: "messages", title: "社群交流", desc: "我们设有不同年级阶段、职业相关交流群，以及各学科方向分群，为不同阶段和类型的成员提供精准高效的交流空间。" },
  { icon: "brandYoutube", title: "宣传推广", desc: "通过官方宣传账号在 B 站等平台持续输出，扩大社区影响力，吸引更多热爱科技的伙伴加入我们。" },
];

// 知识平台 2 卡
const platformItems = [
  { icon: "worldWww", title: "官方网站", desc: "理科迷的线上门户，集成社区介绍、团队展示、博客文章、文档资源等功能，是我们面向公众的第一窗口。" },
  { icon: "fileText", title: "博客系统", desc: "支持 Markdown 和 MDX 格式的文章发布，分类与标签过滤、阅读时间估算、RSS 订阅等功能一应俱全。" },
];
---

<OfficialSidebarLayout title={t(lang, "services.title")} currentPath="/services" sidebarItems={sidebarItems}>
  {/* HeroText 首屏 */}
  <section class="relative not-prose">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
      <div class="py-16 md:py-[80px]">
        <div class="text-center max-w-5xl mx-auto">
          <h1 class="text-[40px] md:text-[56px] font-semibold leading-[1.07] tracking-[-0.005em] mb-4 font-heading text-deep-text">
            {t(lang, "services.hero_title")}
          </h1>
          <div class="max-w-3xl mx-auto">
            <p class="text-[17px] text-text-muted mb-6 leading-relaxed">
              {t(lang, "services.hero_paragraph")}
            </p>
          </div>
          <div class="max-w-xs sm:max-w-md m-auto flex flex-nowrap flex-col sm:flex-row sm:justify-center gap-4">
            <div class="flex w-full sm:w-auto">
              <a href={langUrl(lang, "/about")} class="btn btn-primary w-full sm:w-auto px-8 pointer-events-auto">
                {t(lang, "services.cta_join")}
                <Icon name="arrowRight" class="w-5 h-5 inline-block" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ===== 内容创作 ===== */}
  <section id="content" class="relative not-prose scroll-mt-[72px]">
    <div class="relative max-w-7xl mx-auto px-4 md:px-6 py-16 md:py-20 lg:py-24">
      <div class="mb-8 md:mx-auto md:mb-12 text-center max-w-3xl">
        <h2 class="font-semibold leading-tight font-heading text-3xl md:text-[40px] font-semibold tracking-[-0.005em]">
          {t(lang, "services.section_content")}
        </h2>
        <p class="mt-3 text-[17px] text-text-muted">
          {t(lang, "services.section_content_sub")}
        </p>
      </div>
      <div class="grid mx-auto gap-5 md:gap-6 gap-x-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          contentItems.map((c) => (
            <div class="relative flex flex-col rounded-[12px] bg-page-bg border border-surface-3 p-6 card-hover">
              <div class="flex justify-center">
                <Icon name={c.icon} class="mb-6 w-12 h-12 text-primary" />
              </div>
              <h3 class="text-[17px] font-semibold text-deep-text leading-snug text-center">{c.title}</h3>
              <p class="mt-2 text-[14px] text-text-muted leading-relaxed text-center">{c.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ===== 社区活动 ===== */}
  <section id="events" class="relative not-prose scroll-mt-[72px]">
    <div class="relative max-w-7xl mx-auto px-4 md:px-6 py-16 md:py-20 lg:py-24">
      <div class="mb-8 md:mx-auto md:mb-12 text-center max-w-3xl">
        <h2 class="font-semibold leading-tight font-heading text-3xl md:text-[40px] font-semibold tracking-[-0.005em]">
          {t(lang, "services.section_events")}
        </h2>
        <p class="mt-3 text-[17px] text-text-muted">
          {t(lang, "services.section_events_sub")}
        </p>
      </div>
      <div class="grid mx-auto gap-5 md:gap-6 gap-x-8 sm:grid-cols-2">
        {
          eventItems.map((c) => (
            <div class="relative flex flex-col rounded-[12px] bg-page-bg border border-surface-3 p-6 card-hover">
              <div class="flex justify-center">
                <Icon name={c.icon} class="mb-6 w-12 h-12 text-primary" />
              </div>
              <h3 class="text-[17px] font-semibold text-deep-text leading-snug text-center">{c.title}</h3>
              <p class="mt-2 text-[14px] text-text-muted leading-relaxed text-center">{c.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ===== 知识平台 ===== */}
  <section id="platform" class="relative not-prose scroll-mt-[72px]">
    <div class="relative max-w-7xl mx-auto px-4 md:px-6 py-16 md:py-20 lg:py-24">
      <div class="mb-8 md:mx-auto md:mb-12 text-center max-w-3xl">
        <h2 class="font-semibold leading-tight font-heading text-3xl md:text-[40px] font-semibold tracking-[-0.005em]">
          {t(lang, "services.section_platform")}
        </h2>
        <p class="mt-3 text-[17px] text-text-muted">
          {t(lang, "services.section_platform_sub")}
        </p>
      </div>
      <div class="grid mx-auto gap-5 md:gap-6 gap-x-8 sm:grid-cols-2">
        {
          platformItems.map((c) => (
            <div class="relative flex flex-col rounded-[12px] bg-page-bg border border-surface-3 p-6 card-hover">
              <div class="flex justify-center">
                <Icon name={c.icon} class="mb-6 w-12 h-12 text-primary" />
              </div>
              <h3 class="text-[17px] font-semibold text-deep-text leading-snug text-center">{c.title}</h3>
              <p class="mt-2 text-[14px] text-text-muted leading-relaxed text-center">{c.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ===== 行动号召 ===== */}
  <section class="relative not-prose">
    <div class="relative max-w-7xl mx-auto px-4 md:px-6 py-16 md:py-20 lg:py-24">
      <div class="max-w-3xl mx-auto text-center p-8 rounded-[12px] bg-page-bg border border-surface-3 card-hover">
        <div class="mb-0">
          <h2 class="text-[40px] font-semibold tracking-[-0.005em] mb-3 font-heading">
            {t(lang, "services.cta_question_pre")}<span class="text-[#6C2AD8]">{t(lang, "services.cta_question_accent")}</span>{t(lang, "services.cta_question_post")}
          </h2>
          <p class="text-[17px] text-text-muted">
            {t(lang, "services.cta_body")}
          </p>
        </div>
        <div class="max-w-xs sm:max-w-md m-auto flex flex-nowrap flex-col sm:flex-row sm:justify-center gap-4 mt-6">
          <div class="flex w-full sm:w-auto">
            <a href={langUrl(lang, "/about")} class="btn btn-primary w-full sm:mb-0 pointer-events-auto">
              {t(lang, "services.cta_contact")}
              <Icon name="arrowRight" class="w-5 h-5 inline-block" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</OfficialSidebarLayout>
