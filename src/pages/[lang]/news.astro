---
import OfficialLayout from "../../layouts/OfficialLayout.astro";
import { t } from "../../i18n/index";
import { langUrl } from "../../i18n/paths";

const lang = (Astro.currentLocale ?? "zh") as string;

import { getStaticPathsForLang } from "../../i18n/paths";
export const getStaticPaths = getStaticPathsForLang;

// ===== 新闻资讯索引页（复刻主应用 /official/news，静态分类 + t() 标签）=====

const sections = [
  { label: t(lang, "news.label_announcement"), slug: "announcement", count: 3 },
  { label: t(lang, "news.label_news"), slug: "news", count: 5 },
  { label: t(lang, "news.label_science"), slug: "science", count: 2 },
];
---

<OfficialLayout title={t(lang, "news.title")} currentPath="/news">
  <div class="relative not-prose scroll-mt-[72px]">
    <div class="relative mx-auto max-w-7xl px-4 md:px-6 py-16">
      <div class="space-y-6">
        <header>
          <h1 class="text-3xl font-bold text-deep-text">{t(lang, "news.title")}</h1>
          <p class="mt-2 text-text-muted">{t(lang, "news.subtitle")}</p>
        </header>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            sections.map((section) => (
              <a
                href={langUrl(lang, "/")}
                class="block p-6 bg-card-bg rounded-lg border border-surface-3 hover:border-primary transition-all hover:shadow-lg group"
              >
                <div class="flex flex-col h-full">
                  <h2 class="text-xl font-semibold mb-2 group-hover:text-primary transition-colors">
                    {section.label}
                  </h2>
                  <p class="text-text-muted text-sm mt-auto">
                    {section.count > 0 ? `${section.count} ${t(lang, "news.posts_count")}` : t(lang, "news.click_hint")}
                  </p>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</OfficialLayout>
