---
import OfficialSidebarLayout from "../../layouts/OfficialSidebarLayout.astro";
import MemberCard from "../../components/MemberCard.astro";
import DepartmentSection from "../../components/DepartmentSection.astro";
import { teamData as zhTeam } from "../../data/team-data";
import { teamData as enTeam } from "../../data/en/team-data";
import { pickByLocale, t } from "../../i18n/index";
import type { SubGroupMaps, TeamData, TeamSubGroup } from "../../data/team-types";

const lang = (Astro.currentLocale ?? "zh") as string;

import { getStaticPathsForLang } from "../../i18n/paths";
export const getStaticPaths = getStaticPathsForLang;

// ===== 项目团队页（复刻主应用 /official/project-team，数据来自 team-data.ts）=====
const team = pickByLocale<TeamData>(lang, zhTeam, enTeam);

const sidebarItems = [
  { text: t(lang, "team.sidebar_textbooks"), href: "#textbooks", icon: "books" },
  { text: t(lang, "team.sidebar_science"), href: "#science", icon: "flask" },
];

const sg: SubGroupMaps = team.subGroupMaps;
const pg: Record<string, TeamSubGroup> = sg.projectSubGroups ?? {};
const groups = Object.entries(pg).map(([key, g]) => ({
  key,
  label: g.label ?? "",
  desc: g.desc,
  members: g.members ?? [],
}));

const borderColor: Record<string, string> = {
  textbooks: "#14b8a6",
  science: "#a855f7",
};
---

<OfficialSidebarLayout
  title={t(lang, "team.project_title")}
  currentPath="/project-team"
  sidebarItems={sidebarItems}
>
  {
    groups.map((group) => (
      <DepartmentSection
        id={group.key}
        title={group.label}
        borderColor={borderColor[group.key] ?? "#a855f7"}
        desc={group.desc}
      >
        {group.members.length > 0 ? (
          group.members.map((m) => (
            <MemberCard
              name={m.name ?? ""}
              avatarKey={m.avatarKey}
              role={m.role}
              desc={m.desc}
              dream={m.dream}
              quote={m.quote}
            />
          ))
        ) : (
          <p class="col-span-full text-center text-sm text-text-muted/50 py-6">
            {t(lang, "team.project_empty")}
          </p>
        )}
      </DepartmentSection>
    ))
  }
</OfficialSidebarLayout>
