---
import OfficialSidebarLayout from "../layouts/OfficialSidebarLayout.astro";
import MemberCard from "../components/official/MemberCard.astro";
import DepartmentSection from "../components/official/DepartmentSection.astro";
import { teamData } from "../data/team-data";
import type { MemberLists, SubGroupMaps } from "../data/team-types";

// ===== 团队页（复刻主应用 /official/team，数据来自 team-data.ts 静态 import）=====

const sidebarItems = [
  { text: "创始人", href: "#founder", icon: "star" },
  { text: "总务部", href: "#general", icon: "buildingSkyscraper" },
  { text: "群务部", href: "#affairs", icon: "users" },
  { text: "活动策划部", href: "#events", icon: "calendarEvent" },
  { text: "新闻办", href: "#news", icon: "news" },
  { text: "顾问团", href: "#advisors", icon: "userCheck" },
  { text: "专业委员会", href: "#professional", icon: "certificate" },
  { text: "技术委员会", href: "#tech", icon: "code" },
  { text: "已离开成员", href: "#alumni", icon: "userX" },
];

const ml: MemberLists = teamData.memberLists;
const sg: SubGroupMaps = teamData.subGroupMaps;
---

<OfficialSidebarLayout
  title="管理团队 —— 理科迷"
  currentPath="/team"
  sidebarItems={sidebarItems}
>
  {/* 创始人 */}
  <section id="founder" class="relative not-prose scroll-mt-[72px]">
    <div class="relative mx-auto max-w-7xl px-4 md:px-6 py-16 md:py-20 lg:py-24">
      <h3 class="text-xl font-bold mb-2 text-center">
        <span class="border-b-2 border-primary pb-1">创始人</span>
      </h3>
      <p class="mt-3 text-[17px] text-text-muted text-center mb-9 leading-relaxed">
        理科迷的起点，一切从这里开始
      </p>
      <div class="max-w-2xl mx-auto">
        {
          ml.founderMembers?.map((m) => (
            <MemberCard
              name={m.name ?? ""}
              avatarKey={m.avatarKey}
              role={m.role}
              desc={m.desc}
              dream={m.dream}
              quote={m.quote}
              size="lg"
            />
          ))
        }
      </div>
    </div>
  </section>

  {/* 总务部 */}
  <DepartmentSection
    id="general"
    title="七月团队 · 总务部"
    borderColor="#ef4444"
    desc="该团队部门职责是统筹和规划相关事宜，引领团队能够互相协作，落实我们共同的宗旨和目标。总务部更适合有多线程处理能力以及执行能力的成员，会有跨部门的需要。"
  >
    {
      ml.generalMembers?.map((m) => (
        <MemberCard
          name={m.name ?? ""}
          avatarKey={m.avatarKey}
          role={m.role}
          desc={m.desc}
          dream={m.dream}
          quote={m.quote}
        />
      ))
    }
  </DepartmentSection>

  {/* 群务部 */}
  <DepartmentSection
    id="affairs"
    title="七月团队 · 群务部"
    borderColor="#3b82f6"
    desc="该团队部门职责是负责各个平台上面社群秩序，把握群内风向，确保群处于活跃并且持续有效的学习讨论氛围当中，有情况的时候第一时间处理。群务部更适合有常驻某一平台社群的，并有一定的应急处理能力。"
    noGrid
  >
    {
      Object.entries(sg.affairsSubGroups ?? {}).map(([, group]) => (
        <div class="mb-12">
          <h4 class="text-md font-bold mb-3 text-center text-text-muted">
            {group.label}
          </h4>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {group.members?.map((m) => (
              <MemberCard
                name={m.name ?? ""}
                avatarKey={m.avatarKey}
                role={m.role}
                desc={m.desc}
                dream={m.dream}
                quote={m.quote}
              />
            ))}
          </div>
        </div>
      ))
    }
  </DepartmentSection>

  {/* 活动策划部 */}
  <DepartmentSection
    id="events"
    title="七月团队 · 活动策划部"
    borderColor="#f97316"
    desc="该团队负责的是各个平台上面的活动，一条龙从策划开始，一直到执行，下管专业委员会，给大家带来更多更好的活动和体验，让大家能够真正的学到知识。适合有灵感、有创意并由能把这些全部落实的行动力加入。"
  >
    {
      ml.eventsMembers?.map((m) => (
        <MemberCard
          name={m.name ?? ""}
          avatarKey={m.avatarKey}
          role={m.role}
          desc={m.desc}
          dream={m.dream}
          quote={m.quote}
        />
      ))
    }
  </DepartmentSection>

  {/* 新闻办 */}
  <DepartmentSection
    id="news"
    title="新闻办"
    borderColor="#22c55e"
    desc="该团队部门职责是负责各平台宣传账号的持续运营，以及外交事宜，持续宣传输出并扩大影响能力，并为此向大众输出科普内容，促进传播知识。新闻办会下属一个科普项目组，以及翻译项目组，为科普事业繁荣昌盛，以及中外科技爱好者能有所知识共享，破除信息差和壁垒。"
    noGrid
  >
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        ml.newsMembers?.map((m) => (
          <MemberCard
            name={m.name ?? ""}
            avatarKey={m.avatarKey}
            role={m.role}
            desc={m.desc}
            dream={m.dream}
            quote={m.quote}
          />
        ))
      }
    </div>
    {
      Object.entries(sg.newsSubGroups ?? {}).map(([, group]) => (
        <div class="mt-8">
          <h4 class="text-md font-bold mb-3 text-center text-text-muted">
            {group.label}
          </h4>
          {group.desc && (
            <p class="max-w-3xl mx-auto mb-6 px-6 py-3 bg-page-bg border border-surface-3 rounded-[8px] text-center text-[13px] text-text-muted leading-relaxed">
              {group.desc}
            </p>
          )}
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {group.members?.map((m) => (
              <MemberCard
                name={m.name ?? ""}
                avatarKey={m.avatarKey}
                role={m.role}
                desc={m.desc}
                dream={m.dream}
                quote={m.quote}
              />
            ))}
          </div>
        </div>
      ))
    }
  </DepartmentSection>

  {/* 顾问团 */}
  <DepartmentSection
    id="advisors"
    title="顾问团"
    borderColor="#eab308"
    desc="该团队部门职责是属于理科迷的外部顾问，为理科迷的工作组，项目组事业提供相应的支持，如法律询问、其他社会组织团体等等。"
  >
    {
      ml.advisorMembers?.map((m) => (
        <MemberCard
          name={m.name ?? ""}
          avatarKey={m.avatarKey}
          role={m.role}
          desc={m.desc}
          dream={m.dream}
          quote={m.quote}
        />
      ))
    }
  </DepartmentSection>

  {/* 专业委员会 */}
  <DepartmentSection
    id="professional"
    title="专业委员会"
    borderColor="#a855f7"
    desc="该团队部门职责是负责活动、项目等诸多提供专业知识，充实各个专业实际内容。成员是已经确定了想要在这方面深耕的，未来会下管学术项目组，带来更好的学术交流等内容。"
    noGrid
  >
    {
      Object.entries(sg.professionalSubGroups ?? {}).map(([, group]) => (
        <div class="mb-12">
          <h4 class="text-md font-bold mb-3 text-center text-text-muted">
            {group.label}
          </h4>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {group.members?.map((m) => (
              <MemberCard
                name={m.name ?? ""}
                avatarKey={m.avatarKey}
                role={m.role}
                desc={m.desc}
                dream={m.dream}
                quote={m.quote}
              />
            ))}
          </div>
        </div>
      ))
    }
  </DepartmentSection>

  {/* 技术委员会 */}
  <DepartmentSection
    id="tech"
    title="技术委员会"
    borderColor="#6b7280"
    desc="该团队部门职责是负责各平台、各活动的相应技术上的技术开发与维护，未来将给大家带来更多实用性更强更好的开源项目。需要有编程知识，网站搭建等能。"
  >
    {
      ml.techMembers?.map((m) => (
        <MemberCard
          name={m.name ?? ""}
          avatarKey={m.avatarKey}
          role={m.role}
          desc={m.desc}
          dream={m.dream}
          quote={m.quote}
        />
      ))
    }
  </DepartmentSection>

  {/* 已离开成员 */}
  <section id="alumni" class="relative not-prose scroll-mt-[72px]">
    <div class="relative mx-auto max-w-7xl px-4 md:px-6 py-16 md:py-20 lg:py-24">
      <h3 class="text-xl font-bold mb-9 text-center">
        <span class="border-b-2 border-surface-3 pb-1">已离开或失联成员</span>
      </h3>
      <p class="max-w-3xl mx-auto mb-9 px-6 py-4 bg-page-bg border border-surface-3 rounded-[8px] text-center text-[14px] text-text-muted leading-relaxed">
        以下成员曾为理科迷作出贡献，因各种原因现无法联系，不管如何理科迷的大门永远向你们打开。
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          ml.alumniMembers?.map((m) => (
            <MemberCard
              name={m.name ?? ""}
              avatarKey={m.avatarKey}
              role={m.role}
              desc={m.desc}
              dream={m.dream}
              quote={m.quote}
            />
          ))
        }
      </div>
    </div>
  </section>
</OfficialSidebarLayout>
