---
import { SITE_NAME } from "~/data/config";
import { t } from "../i18n/index";
import type { TranslationKey } from "../i18n/index";
import { langUrl } from "../i18n/paths";
import LanguageSwitcher from "./LanguageSwitcher.astro";

const lang = (Astro.currentLocale ?? "zh") as string;
const nav: { href: string; labelKey: TranslationKey }[] = [
  { href: "/", labelKey: "common.nav_home" },
  { href: "/about", labelKey: "common.nav_about" },
  { href: "/services", labelKey: "common.nav_services" },
];
---

<header class="sticky top-0 z-40 border-b border-[#e0e0e0] bg-white/90 backdrop-blur">
  <nav class="relative w-full max-w-[var(--page-width)] mx-auto px-6 flex h-14 items-center justify-between">
    <a href={langUrl(lang, "/")} class="font-heading font-bold text-[1.05rem]">{SITE_NAME}</a>
    <ul class="absolute left-1/2 top-1/2 hidden -translate-x-1/2 -translate-y-1/2 items-center gap-20 sm:flex">
      {nav.map((item) => (
        <li>
          <a
            href={langUrl(lang, item.href)}
            class:list={[
              "text-sm transition-colors whitespace-nowrap",
              Astro.url.pathname === item.href
                ? "text-[var(--primary)]"
                : "text-[#1d1d1f] hover:text-[var(--primary)]",
            ]}
          >
            {t(lang, item.labelKey)}
          </a>
        </li>
      ))}
    </ul>
    <LanguageSwitcher />
  </nav>
</header>
