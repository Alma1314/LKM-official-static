---
import Icon from "./Icon.astro";
import { SITE_NAME } from "../../data/config";

// 社区顶栏：复刻主应用 FuwariNavbar 的视觉（高 72px、白底圆角、home 图标 + 站点名）。
// 静态站无搜索/登录/明暗切换等无实义部件，保留骨架与视觉一致性。
interface Props {
  active?: string;
}
const { active = "" } = Astro.props;
---

<div class="sticky top-0 z-50">
  <div class="h-8 bg-white transition-colors"></div>
  <div
    class:list={[
      "bg-white rounded-b-lg overflow-hidden shadow-sm h-[4.5rem] grid grid-cols-[0.6fr_auto_1fr] items-center px-4",
    ]}
  >
    <div class:list={["flex items-center gap-1 justify-self-start"]}>
      <a
        href="/"
        class="rounded-lg h-[3.25rem] px-5 font-bold active:scale-95 flex items-center text-neutral-800 hover:bg-black/5 transition-colors"
      >
        <span class="flex flex-row items-center text-[var(--primary)] text-md">
          <Icon name="home" class="w-7 h-7 mb-1 mr-2" />
          {SITE_NAME}
        </span>
      </a>
    </div>

    <div class="flex items-center gap-1 justify-self-end">
      <a
        href="/"
        class="rounded-lg h-11 px-4 font-bold active:scale-95 flex items-center gap-1 text-sm text-[var(--deep-text)] hover:text-[var(--primary)] hover:bg-black/5 transition-colors"
      >
        返回官网
      </a>
      <a
        href="/community"
        class:list={[
          "rounded-lg h-11 px-4 font-bold active:scale-95 flex items-center text-sm transition-colors",
          active === "/community"
            ? "text-[var(--primary)] hover:bg-black/5"
            : "text-[var(--deep-text)] hover:text-[var(--primary)] hover:bg-black/5",
        ]}
      >
        社区
      </a>
    </div>
  </div>
</div>
