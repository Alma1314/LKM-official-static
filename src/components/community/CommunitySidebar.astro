---
import Icon from "./Icon.astro";
import styles from "./CommunitySidebar.module.css";

interface SidebarItem {
  text: string;
  href: string;
  icon: string;
}

interface Props {
  items: SidebarItem[];
  currentPath: string;
}

const { items, currentPath } = Astro.props;

function isActive(href: string): boolean {
  return currentPath === href || currentPath.startsWith(href + "/");
}
---

<nav class={styles.shell} data-community-sidebar aria-label="社区导航">
  <ul class={styles.nav}>
    {
      items.map((item) => (
        <li class:list={{ [styles.active]: isActive(item.href) }}>
          <a href={item.href}>
            <div class={styles.icon}>
              <Icon name={item.icon} />
            </div>
            <div class={styles.text}>{item.text}</div>
          </a>
        </li>
      ))
    }
  </ul>

  <button
    type="button"
    class={styles.toggle}
    id="community-sidebar-toggle"
    aria-label="收起/展开侧边栏"
  >
    <Icon name="chevron" />
    <span class={styles.toggleSpan}>收起</span>
  </button>
</nav>

<script is:inline>
  (() => {
    const shell = document.querySelector("[data-community-sidebar]");
    if (!shell) return;
    const btn = document.getElementById("community-sidebar-toggle");
    const TOGGLE = "sidebar-collapsed";
    const root = document.documentElement;

    // 展开/收起统一入口：仅切换 root 上的 TOGGLE 类，
    // 侧边栏宽度与 main 偏移均由 CSS 用该选择器驱动。
    function setCollapsed(collapsed: boolean): void {
      root.classList.toggle(TOGGLE, collapsed);
    }

    const stored = localStorage.getItem("community-sidebar-expanded");
    const mobile = window.matchMedia("(max-width: 767px)").matches;
    const defaultCollapsed = stored !== null ? stored !== "true" : mobile;

    const prev = root.style.transition;
    root.style.transition = "none";
    setCollapsed(defaultCollapsed);
    // 强制回流避免错误过渡动画；随后复原
    void (shell as HTMLElement).offsetWidth;
    root.style.transition = prev;

    btn?.addEventListener("click", (e: Event) => {
      e.preventDefault();
      e.stopPropagation();
      const nowCollapsed = root.classList.contains(TOGGLE);
      setCollapsed(!nowCollapsed);
      localStorage.setItem(
        "community-sidebar-expanded",
        String(!nowCollapsed),
      );
    });
  })();
</script>
